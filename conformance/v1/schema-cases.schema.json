{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/0al-spec/agent-surface/conformance/schemas/schema-cases/v1",
  "title": "ASP Conformance Schema Cases v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "suite_id",
    "suite_version",
    "cases"
  ],
  "properties": {
    "$schema": {
      "const": "./schema-cases.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "suite_id": {
      "const": "https://github.com/0al-spec/agent-surface/conformance/suite/v1"
    },
    "suite_version": {
      "const": "1.10.3"
    },
    "cases": {
      "type": "array",
      "minItems": 134,
      "maxItems": 134,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "operationalContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_ids",
        "idempotency_required_action_ids",
        "event_ids",
        "control_event_ids"
      ],
      "properties": {
        "action_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "idempotency_required_action_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "event_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "control_event_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "capacityContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared_limit_ids",
        "disclosable_limit_ids"
      ],
      "properties": {
        "declared_limit_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "disclosable_limit_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "emptyContext": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "riskExplanationContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect_ids"
      ],
      "properties": {
        "effect_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "mcpContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requested_resource_uri": { "type": "string", "format": "uri" },
        "resource_kind": { "enum": ["manifest", "receipt"] },
        "expected_resource": { "type": "object" },
        "resource_hash_domain": { "type": "string", "format": "uri" },
        "expected_resource_hash": { "type": "string", "pattern": "^sha-256:[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$" },
        "expected_receipt_type": { "enum": ["app", "runtime", "approval"] },
        "expected_receipt_semantics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["result", "error", "output_hash", "actual_effects", "actual_effects_hash", "effect_outcome", "resource"],
          "properties": {
            "result": { "type": "string", "minLength": 1 },
            "error": { "type": ["object", "null"] },
            "output_hash": { "type": ["string", "null"], "pattern": "^sha-256:[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$" },
            "actual_effects": { "type": ["array", "null"] },
            "actual_effects_hash": { "type": ["string", "null"], "pattern": "^sha-256:[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$" },
            "effect_outcome": { "type": ["string", "null"], "enum": ["applied", "partially_applied", "not_applied", "unknown", null] },
            "resource": { "type": ["object", "null"] }
          }
        },
        "expected_authorized_projection": { "type": "object" },
        "authorized_projection_expected": { "type": "boolean" },
        "expected_binding_record": { "type": "object" },
        "expected_tool_records": { "type": "array", "items": { "type": "object" } },
        "expected_surface_hash": { "type": "string", "pattern": "^sha-256:[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$" },
        "expected_request_payload": { "type": "object" },
        "expected_schema_dialect": { "type": "string", "format": "uri" },
        "expected_input_schema": { "type": "object" },
        "expected_input_schema_uri": { "type": "string", "format": "uri" },
        "expected_output_schema": { "type": "object" },
        "expected_output_schema_uri": { "type": "string", "format": "uri" },
        "expected_output_schema_hash": { "type": "string", "pattern": "^sha-256:[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$" },
        "expected_actual_effects": { "type": "array" },
        "expected_preview": { "type": "object" },
        "expected_preview_preconditions": {},
        "expected_preview_effects": { "type": "array" },
        "expected_revert_evidence": {},
        "evaluation_time": { "type": "string", "format": "date-time" },
        "expected_final_approval_receipt_hashes": { "type": "object" },
        "expected_authenticated_receipt_resources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["uri", "receipt", "expected"],
            "properties": {
              "uri": { "type": "string", "format": "uri" },
              "receipt": { "type": "object" },
              "expected": {
                "type": "object",
                "additionalProperties": false,
                "required": ["receipt_id", "receipt_hash", "receipt_type", "approval_role", "binding", "signature_required"],
                "properties": {
                  "receipt_id": { "type": "string", "minLength": 1 },
                  "receipt_hash": { "type": "string", "pattern": "^sha-256:[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$" },
                  "receipt_type": { "enum": ["app", "runtime", "approval"] },
                  "approval_role": { "type": ["string", "null"], "enum": ["runtime", "application", null] },
                  "binding": { "type": "object" },
                  "signature_required": { "type": "boolean" }
                }
              }
            }
          }
        },
        "expected_receipt_resource_uris": { "type": "array", "uniqueItems": true, "items": { "type": "string", "format": "uri" } },
        "prior_tool_names": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "prior_action_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "action_mode": { "enum": ["read", "dry_run", "propose", "reserve", "commit", "compensate", "revert"] },
        "expected_result": { "type": "string", "minLength": 1 },
        "idempotency_required": { "type": "boolean" },
        "receipt_required": { "type": "boolean" }
        ,"expected_credential_audience": { "type": "string", "format": "uri" }
        ,"expected_endpoint": { "type": "string", "format": "uri" }
        ,"expected_proof_target_uri": { "type": "string", "format": "uri" }
        ,"expected_manifest_resource_uri": { "type": "string", "format": "uri" }
        ,"expected_authorization_composition": { "enum": ["asp-native", "mcp-oauth-dual-use"] }
        ,"expected_request_id": { "oneOf": [{"type":"string"},{"type":"integer"}] }
        ,"expected_progress_token": { "oneOf": [{"type":"string"},{"type":"integer"}] }
        ,"expected_cancelled_request_id": { "oneOf": [{"type":"string"},{"type":"integer"}] }
        ,"expected_cursor": { "type": "string", "minLength": 1 }
        ,"prior_request_ids": { "type": "array", "uniqueItems": true, "items": { "oneOf": [{"type":"string"},{"type":"integer"}] } }
        ,"prior_cursors": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        ,"tools_list_first_page": { "type": "boolean" }
        ,"forbidden_credential_values": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        ,"capacity_declared_limit_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        ,"capacity_disclosable_limit_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "impactSimulationContext": {
      "oneOf": [
        {
          "$ref": "#/$defs/emptyContext"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evaluation_time",
            "current_binding_facts",
            "bindings",
            "freshness_deadlines",
            "requested_action_ids",
            "requested_scope_ids",
            "candidate_check_facts",
            "matched_candidate",
            "actions"
          ],
          "properties": {
            "evaluation_time": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z(?![\\s\\S])"
            },
            "current_binding_facts": {
              "$ref": "https://github.com/0al-spec/agent-surface/conformance/schemas/fixtures/v1#/$defs/impactCurrentBindingFacts"
            },
            "bindings": {
              "$ref": "https://github.com/0al-spec/agent-surface/conformance/schemas/impact-simulation/v1#/$defs/bindings"
            },
            "freshness_deadlines": {
              "$ref": "https://github.com/0al-spec/agent-surface/conformance/schemas/fixtures/v1#/$defs/impactFreshnessDeadlines"
            },
            "requested_action_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "requested_scope_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "candidate_check_facts": {
              "type": "array",
              "minItems": 24,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "$ref": "https://github.com/0al-spec/agent-surface/conformance/schemas/fixtures/v1#/$defs/impactCandidateCheckFact"
              }
            },
            "matched_candidate": {
              "$ref": "https://github.com/0al-spec/agent-surface/conformance/schemas/fixtures/v1#/$defs/impactMatchedCandidate"
            },
            "actions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "https://github.com/0al-spec/agent-surface/conformance/schemas/fixtures/v1#/$defs/impactActionDeclaration"
              }
            }
          }
        }
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "schema_id",
        "polarity",
        "instance_json",
        "context"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^ASP-SC-(OL|CE|HE|IS|RE|MB|PB)-[0-9]{3}$"
        },
        "schema_id": {
          "enum": [
            "https://github.com/0al-spec/agent-surface/conformance/schemas/operational-limits/v1",
            "https://github.com/0al-spec/agent-surface/conformance/schemas/capacity-error/v1",
            "https://github.com/0al-spec/agent-surface/conformance/schemas/human-elicitation/v1",
            "https://github.com/0al-spec/agent-surface/conformance/schemas/impact-simulation/v1",
            "https://github.com/0al-spec/agent-surface/conformance/schemas/risk-explanation/v1",
            "https://github.com/0al-spec/agent-surface/conformance/schemas/mcp-binding/v1",
            "https://github.com/0al-spec/agent-surface/conformance/schemas/purpose-task-bound-grant/v1"
          ]
        },
        "polarity": {
          "enum": [
            "positive",
            "negative"
          ]
        },
        "instance_json": {
          "type": "string",
          "minLength": 1
        },
        "context": {}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "schema_id": {
                "const": "https://github.com/0al-spec/agent-surface/conformance/schemas/operational-limits/v1"
              }
            },
            "required": [
              "schema_id"
            ]
          },
          "then": {
            "properties": {
              "context": {
                "$ref": "#/$defs/operationalContext"
              }
            }
          },
          "else": {
            "if": {
              "properties": {
                "schema_id": {
                  "const": "https://github.com/0al-spec/agent-surface/conformance/schemas/capacity-error/v1"
                }
              },
              "required": [
                "schema_id"
              ]
            },
            "then": {
              "properties": {
                "context": {
                  "$ref": "#/$defs/capacityContext"
                }
              }
            },
            "else": {
              "if": {
                "properties": {
                  "schema_id": {
                    "const": "https://github.com/0al-spec/agent-surface/conformance/schemas/risk-explanation/v1"
                  }
                },
                "required": [
                  "schema_id"
                ]
              },
              "then": {
                "properties": {
                  "context": {
                    "$ref": "#/$defs/riskExplanationContext"
                  }
                }
              },
              "else": {
                "if": {
                  "properties": {
                    "schema_id": {
                      "const": "https://github.com/0al-spec/agent-surface/conformance/schemas/impact-simulation/v1"
                    }
                  },
                  "required": [
                    "schema_id"
                  ]
                },
                "then": {
                  "properties": {
                    "context": {
                      "$ref": "#/$defs/impactSimulationContext"
                    }
                  }
                },
                "else": {
                  "if": {
                    "properties": {
                      "schema_id": {
                        "const": "https://github.com/0al-spec/agent-surface/conformance/schemas/mcp-binding/v1"
                      }
                    },
                    "required": ["schema_id"]
                  },
                  "then": {
                    "properties": {
                      "context": { "$ref": "#/$defs/mcpContext" }
                    }
                  },
                  "else": {
                    "properties": {
                      "context": { "$ref": "#/$defs/emptyContext" }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
