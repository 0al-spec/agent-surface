{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/0al-spec/agent-surface/publication/schemas/standalone-modules/v1",
  "title": "ASP Non-Authoritative Standalone Module Set v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "standalone_set_id",
    "authority",
    "publication_mode_required",
    "ownership_map",
    "materialization",
    "generation_policy",
    "reference_policy",
    "documents",
    "navigation_references",
    "public_anchor_relocations"
  ],
  "properties": {
    "$schema": {
      "const": "./standalone.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "standalone_set_id": {
      "const": "https://github.com/0al-spec/agent-surface/publication/standalone-modules/v1"
    },
    "authority": {
      "const": "non_authoritative_migration_candidate"
    },
    "publication_mode_required": {
      "const": "transitional_monolith"
    },
    "ownership_map": {
      "$ref": "#/$defs/digestRef"
    },
    "materialization": {
      "$ref": "#/$defs/digestRef"
    },
    "generation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_order",
        "orphan_heading_policy",
        "aggregate_title",
        "aggregate_toc"
      ],
      "properties": {
        "content_order": {
          "const": "canonical_order_within_owner"
        },
        "orphan_heading_policy": {
          "const": "promote_subtree_root_to_h2"
        },
        "aggregate_title": {
          "const": "replace_with_reserved_document_title"
        },
        "aggregate_toc": {
          "const": "replace_with_exact_document_set_navigation"
        }
      }
    },
    "reference_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normative_tuple",
        "navigation_anchor",
        "public_relocation",
        "implicit_slugs"
      ],
      "properties": {
        "normative_tuple": {
          "const": "document_id_exact_version"
        },
        "navigation_anchor": {
          "const": "candidate_local_github_slug"
        },
        "public_relocation": {
          "const": "old_tuple_to_new_tuple"
        },
        "implicit_slugs": {
          "const": "non_public_navigation_only"
        }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/document"
      }
    },
    "navigation_references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/navigationReference"
      }
    },
    "public_anchor_relocations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relocation"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "documentId": {
      "type": "string",
      "pattern": "^https://github\\.com/0al-spec/agent-surface/documents/[a-z0-9]+(?:[/-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^/\\\\](?:[^\\\\]*[^/\\\\])?$"
    },
    "anchorId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "digestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repoPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "documentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "version"
      ],
      "properties": {
        "document_id": {
          "$ref": "#/$defs/documentId"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "anchor_id": {
          "$ref": "#/$defs/anchorId"
        }
      }
    },
    "normativeReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "version",
        "candidate_path"
      ],
      "properties": {
        "document_id": {
          "$ref": "#/$defs/documentId"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "candidate_path": {
          "$ref": "#/$defs/repoPath"
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "version",
        "title",
        "target_source_path",
        "candidate_path",
        "sha256",
        "content_fragments",
        "normative_references"
      ],
      "properties": {
        "document_id": {
          "$ref": "#/$defs/documentId"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "target_source_path": {
          "$ref": "#/$defs/repoPath"
        },
        "candidate_path": {
          "$ref": "#/$defs/repoPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "content_fragments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "normative_references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/normativeReference"
          }
        }
      }
    },
    "navigationReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "heading",
        "source_document_id",
        "target_document_id",
        "target_version",
        "target_candidate_path",
        "target_anchor_id"
      ],
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1
        },
        "source_document_id": {
          "$ref": "#/$defs/documentId"
        },
        "target_document_id": {
          "$ref": "#/$defs/documentId"
        },
        "target_version": {
          "$ref": "#/$defs/version"
        },
        "target_candidate_path": {
          "$ref": "#/$defs/repoPath"
        },
        "target_anchor_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:-[0-9]+)?$"
        }
      }
    },
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value",
        "status"
      ],
      "properties": {
        "kind": {
          "enum": [
            "legacy_aggregate_path_fragment",
            "legacy_aggregate_fragment"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 2
        },
        "status": {
          "const": "transition_only"
        }
      }
    },
    "relocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "heading",
        "previous",
        "replacement",
        "compatibility_aliases"
      ],
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1
        },
        "previous": {
          "$ref": "#/$defs/documentRef"
        },
        "replacement": {
          "allOf": [
            {
              "$ref": "#/$defs/documentRef"
            },
            {
              "required": [
                "anchor_id"
              ]
            }
          ]
        },
        "compatibility_aliases": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/alias"
          }
        }
      }
    }
  }
}
